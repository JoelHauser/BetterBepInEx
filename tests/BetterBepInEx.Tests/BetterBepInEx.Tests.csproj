<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      The linked Core files are written for the plugin's net472 build, which has nullable off, so
      they raise nullable warnings here that mean nothing for the code that ships.
    -->
    <NoWarn>$(NoWarn);CS8600;CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Linked rather than project referenced. The plugin targets net472 against BepInEx and Unity,
    which a test host cannot load, so the pure half (src\BetterBepInEx\Core, which must stay free of
    Unity and BepInEx) is compiled into the test assembly directly.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\BetterBepInEx\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
